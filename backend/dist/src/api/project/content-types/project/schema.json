{
    "kind": "collectionType",
    "collectionName": "projects",
    "info": {
        "singularName": "project",
        "pluralName": "projects",
        "displayName": "Project"
    },
    "options": {
        "draftAndPublish": true
    },
    "attributes": {
        "title": {
            "type": "string",
            "required": true
        },
        "slug": {
            "type": "uid",
            "targetField": "title",
            "required": true
        },
        "image": {
            "type": "media",
            "multiple": false,
            "required": false,
            "allowedTypes": ["images"]
        },
        "shortDescription": {
            "type": "text"
        },
        "description": {
            "type": "richtext"
        },
        "goalAmount": {
            "type": "decimal"
        },
        "currentAmount": {
            "type": "decimal"
        },
        "isActive": {
            "type": "boolean",
            "default": true
        }
    }
}
