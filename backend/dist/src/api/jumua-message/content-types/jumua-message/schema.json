{
    "kind": "collectionType",
    "collectionName": "jumua_messages",
    "info": {
        "singularName": "jumua-message",
        "pluralName": "jumua-messages",
        "displayName": "Jumua Message"
    },
    "options": {
        "draftAndPublish": true
    },
    "attributes": {
        "title": {
            "type": "string",
            "required": true
        },
        "message": {
            "type": "text",
            "required": true
        },
        "image": {
            "type": "media",
            "multiple": false,
            "required": false,
            "allowedTypes": ["images"]
        },
        "times": {
            "type": "json"
        },
        "isActive": {
            "type": "boolean",
            "default": true
        },
        "order": {
            "type": "integer",
            "default": 0
        },
        "validFrom": {
            "type": "date"
        },
        "validUntil": {
            "type": "date"
        }
    }
}
