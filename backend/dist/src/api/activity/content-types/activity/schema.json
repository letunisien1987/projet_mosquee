{
    "kind": "collectionType",
    "collectionName": "activities",
    "info": {
        "singularName": "activity",
        "pluralName": "activities",
        "displayName": "Activity"
    },
    "options": {
        "draftAndPublish": true
    },
    "attributes": {
        "title": {
            "type": "string",
            "required": true
        },
        "slug": {
            "type": "uid",
            "targetField": "title",
            "required": true
        },
        "category": {
            "type": "enumeration",
            "enum": ["coran", "arabe", "ecole", "tajweed", "hifz", "halaqat", "autre"],
            "required": true
        },
        "description": {
            "type": "text"
        },
        "content": {
            "type": "richtext"
        },
        "level": {
            "type": "enumeration",
            "enum": ["Débutant", "Intermédiaire", "Avancé", "Tous niveaux"]
        },
        "ageGroup": {
            "type": "string"
        },
        "schedule": {
            "type": "string"
        },
        "instructor": {
            "type": "relation",
            "relation": "manyToOne",
            "target": "api::team-member.team-member"
        },
        "maxParticipants": {
            "type": "integer"
        },
        "requiresApproval": {
            "type": "boolean",
            "default": false
        },
        "price": {
            "type": "decimal"
        },
        "active": {
            "type": "boolean",
            "default": true
        },
        "enrollmentOpen": {
            "type": "boolean",
            "default": true
        }
    }
}
