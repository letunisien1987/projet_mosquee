// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  IMAM
  TEACHER
  STAFF
  MANAGER    // Gestionnaire d'activités/événements (peut gérer ses propres activités/événements)
  TRESORIER  // Trésorier - gestion financière, dons et remboursements
  MEMBER
}

enum MembershipType {
  ACTIF       // Membre actif avec droit de vote
  PASSIF      // Membre passif sans droit de vote
  // Types obsolètes conservés pour compatibilité avec données existantes:
  INDIVIDUAL  // @deprecated - Utiliser PASSIF
  FAMILY      // @deprecated - Utiliser ACTIF
  STUDENT     // @deprecated - Utiliser PASSIF
  SENIOR      // @deprecated - Utiliser PASSIF
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  PENDING
}

enum DonationType {
  ZAKAT
  SADAQA
  ZAKAT_AL_FITR
  PROJECT
  MEMBERSHIP
}

enum ServiceType {
  MARRIAGE
  FUNERAL
  SHAHADA
  AQIQA
}

enum ServiceStatus {
  PENDING
  APPROVED
  COMPLETED
  CANCELLED
}

enum EnrollmentStatus {
  PENDING
  APPROVED
  REJECTED
  WAITING_LIST
  INTERVIEW_REQUIRED
  ACTIVE
}

enum RegistrationStatus {
  PENDING
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
}

// Statuts de paiement:
// - PENDING: En attente de paiement
// - PAID: Paiement reçu (utilisé pour Membership.paymentStatus)
// - COMPLETED: Traitement terminé (paiement + email + mise à jour = utilisé pour Payment.status)
// - FAILED/REFUNDED/CANCELLED: États finaux
enum PaymentStatus {
  PENDING     // En attente de paiement
  PAID        // Paiement reçu par Stripe
  COMPLETED   // Paiement traité et confirmé (email envoyé, etc.)
  FAILED      // Paiement échoué
  REFUNDED    // Remboursé
  CANCELLED   // Annulé
}

enum NotificationType {
  EVENT_CONFIRMATION
  EVENT_REGISTRATION_NEW          // Nouvelle inscription (pour responsables)
  EVENT_REMINDER
  EVENT_CANCELLED
  EVENT_WAITLIST_SPOT_AVAILABLE
  EVENT_PAYMENT_PENDING           // Paiement événement en attente
  EVENT_PAYMENT_RECEIVED          // Paiement événement reçu (pour responsables)
  ENROLLMENT_CONFIRMATION
  ENROLLMENT_APPROVED
  ENROLLMENT_REJECTED
  ENROLLMENT_PAYMENT_PENDING      // Paiement activité en attente
  ENROLLMENT_PAYMENT_CONFIRMED    // Paiement activité confirmé
  PAYMENT_PENDING
  PAYMENT_CONFIRMED
  PAYMENT_FAILED
  MEMBERSHIP_PENDING_PAYMENT
  MEMBERSHIP_CONFIRMED
  MEMBERSHIP_REFUNDED
  MEMBERSHIP_EXPIRING_SOON
  DONATION_CONFIRMED
  REFUND_REQUEST              // Nouvelle demande de remboursement (pour responsables)
  REFUND_APPROVED             // Demande de remboursement approuvée
  REFUND_REJECTED             // Demande de remboursement rejetée
  EVENT_CANCELLATION          // Annulation d'inscription
  SYSTEM
  REMINDER
}

enum MembershipRequestStatus {
  PENDING         // En attente de validation admin
  APPROVED        // Approuvé, en attente de paiement
  PAYMENT_SENT    // Lien de paiement envoyé
  COMPLETED       // Payé et membership créé
  REJECTED        // Refusé par admin
  EXPIRED         // Lien de paiement expiré (> 7 jours)
}

// NOTE: Les enums ActivityStatus et ActivityCategory ont été supprimés car non utilisés
// Les catégories d'activités sont gérées dans Directus comme strings

// Permissions pour l'interface d'administration
enum AdminPermission {
  // Gestion des utilisateurs et membres
  VIEW_MEMBERS            // Voir la liste des membres
  MANAGE_MEMBERS          // Ajouter, modifier, supprimer des membres
  MANAGE_ROLES            // Changer les rôles des utilisateurs

  // Gestion des événements
  VIEW_EVENTS             // Voir les événements
  MANAGE_EVENTS           // Créer, modifier, supprimer des événements
  VIEW_EVENT_REGISTRATIONS // Voir les inscriptions aux événements
  MANAGE_EVENT_REGISTRATIONS // Gérer les inscriptions (confirmer, annuler)

  // Gestion des activités
  VIEW_ACTIVITIES         // Voir les activités
  MANAGE_ACTIVITIES       // Créer, modifier, supprimer des activités
  VIEW_ENROLLMENTS        // Voir les inscriptions aux activités
  MANAGE_ENROLLMENTS      // Gérer les inscriptions (approuver, rejeter)

  // Gestion financière
  VIEW_DONATIONS          // Voir les dons
  MANAGE_DONATIONS        // Gérer les dons
  VIEW_MEMBERSHIPS        // Voir les cotisations
  MANAGE_MEMBERSHIPS      // Gérer les cotisations
  REFUND_MEMBERSHIPS      // Rembourser les cotisations

  // Communication
  VIEW_MESSAGES           // Voir les messages de contact
  MANAGE_MESSAGES         // Répondre, marquer comme lu, supprimer
  VIEW_SERVICES           // Voir les demandes de services
  MANAGE_SERVICES         // Gérer les demandes de services

  // Configuration
  VIEW_PRAYER_TIMES       // Voir les horaires de prière
  MANAGE_PRAYER_TIMES     // Modifier les horaires de prière
  VIEW_SETTINGS           // Voir les paramètres
  MANAGE_SETTINGS         // Modifier les paramètres

  // Administration complète
  ADMIN_ACCESS            // Accès complet à l'administration
}

// ============================================================================
// MODÈLES DE CONTENU (anciennement dans Directus)
// ============================================================================

// ============ ÉVÉNEMENTS ============
model Event {
  id                    String   @id @default(uuid()) @db.Uuid
  title                 String
  slug                  String   @unique
  description           String?
  content               String?  // HTML
  category              String   // 'religieux', 'communaute', 'education', 'charite'

  // Date/Lieu
  date                  DateTime
  startTime             String?
  endTime               String?
  location              String?

  // Image (Cloudinary URL)
  imageUrl              String?

  // Inscription
  registrationRequired  Boolean  @default(true)
  maxCapacity           Int?
  requiresApproval      Boolean  @default(false)
  registrationDeadline  DateTime?

  // Publication
  published             Boolean  @default(false)
  featured              Boolean  @default(false)

  // Paiement
  price                 Float?
  paymentType           String?  // 'FREE', 'ONE_TIME', 'SUBSCRIPTION'
  subscriptionInterval  String?  // 'WEEKLY', 'MONTHLY', 'YEARLY'
  pricing               Json?    // Tarification avancée

  // Remboursement
  allowRefund           Boolean  @default(false)
  cancellationDeadlineDays Int?

  // Responsable
  managerId             String?  @db.Uuid
  managerEmail          String?
  manager               User?    @relation("EventManager", fields: [managerId], references: [id])

  // Restrictions
  restrictions          Json?

  // Contact organisateur
  showOrganizerName     Boolean  @default(true)
  showOrganizerEmail    Boolean  @default(true)
  showOrganizerPhone    Boolean  @default(false)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  registrations         EventRegistration[]
  waitingLists          WaitingList[] @relation("EventWaitingList")
  payments              Payment[] @relation("EventPayment")

  @@map("events")
  @@index([slug])
  @@index([date])
  @@index([published])
  @@index([managerId])
}

// ============ ACTIVITÉS ============
model Activity {
  id                    String   @id @default(uuid()) @db.Uuid
  title                 String
  slug                  String   @unique
  description           String?
  content               String?
  category              String   // 'coran', 'arabe', 'ecole', 'tajweed', 'hifz', 'halaqat'

  // Détails
  level                 String?
  ageGroup              String?
  schedule              String?
  instructorName        String?

  // Image
  imageUrl              String?

  // Inscription
  maxParticipants       Int?
  requiresApproval      Boolean  @default(false)
  enrollmentOpen        Boolean  @default(true)
  active                Boolean  @default(true)

  // Paiement
  price                 Float?
  paymentType           String?
  subscriptionInterval  String?
  pricing               Json?

  // Remboursement
  allowRefund           Boolean  @default(false)
  cancellationDeadlineDays Int?

  // Responsable
  managerId             String?  @db.Uuid
  managerEmail          String?
  manager               User?    @relation("ActivityManager", fields: [managerId], references: [id])

  // Restrictions & Contact
  restrictions          Json?
  showOrganizerName     Boolean  @default(true)
  showOrganizerEmail    Boolean  @default(true)
  showOrganizerPhone    Boolean  @default(false)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  enrollments           Enrollment[]
  waitingLists          WaitingList[] @relation("ActivityWaitingList")

  @@map("activities")
  @@index([slug])
  @@index([category])
  @@index([active])
  @@index([managerId])
}

// ============ PROJETS DONS ============
model Project {
  id                    String   @id @default(uuid()) @db.Uuid
  title                 String
  slug                  String   @unique
  description           String?
  content               String?
  goalAmount            Float
  currentAmount         Float    @default(0)
  imageUrl              String?
  raiseNowCode          String?
  startDate             DateTime?
  endDate               DateTime?
  priority              Int      @default(0)
  active                Boolean  @default(true)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  donations             Donation[]

  @@map("projects")
  @@index([active])
}

// ============ ÉQUIPE ============
model TeamMember {
  id                    String   @id @default(uuid()) @db.Uuid
  name                  String
  role                  String   // 'imam', 'president', 'treasurer', 'teacher', etc.
  bio                   String?
  photoUrl              String?
  email                 String?
  phone                 String?
  displayOrder          Int      @default(0)
  active                Boolean  @default(true)

  // Lien optionnel vers User
  userId                String?  @unique @db.Uuid
  user                  User?    @relation(fields: [userId], references: [id])

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("team_members")
  @@index([active])
  @@index([displayOrder])
}

// ============ MESSAGES JUMUA ============
model JumuaMessage {
  id                    String   @id @default(uuid()) @db.Uuid
  title                 String
  message               String
  imageUrl              String?
  times                 String[] @default([])
  isActive              Boolean  @default(false)
  displayOrder          Int      @default(0)
  validFrom             DateTime?
  validUntil            DateTime?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("jumua_messages")
  @@index([isActive])
  @@index([displayOrder])
}

// ============ ARTICLES ============
model Article {
  id                    String   @id @default(uuid()) @db.Uuid
  title                 String
  slug                  String   @unique
  excerpt               String?
  content               String
  category              String?
  imageUrl              String?
  authorId              String?  @db.Uuid
  author                User?    @relation(fields: [authorId], references: [id])
  publishedAt           DateTime
  featured              Boolean  @default(false)
  published             Boolean  @default(true)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("articles")
  @@index([slug])
  @@index([published])
}

// ============ GALERIES ============
model Gallery {
  id                    String   @id @default(uuid()) @db.Uuid
  title                 String
  description           String?
  category              String?
  date                  DateTime?
  published             Boolean  @default(true)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  images                GalleryImage[]

  @@map("galleries")
  @@index([published])
}

model GalleryImage {
  id                    String   @id @default(uuid()) @db.Uuid
  galleryId             String   @db.Uuid
  gallery               Gallery  @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  imageUrl              String
  caption               String?
  displayOrder          Int      @default(0)

  createdAt             DateTime @default(now())

  @@map("gallery_images")
  @@index([galleryId])
}

// ============================================================================
// FIN DES MODÈLES DE CONTENU
// ============================================================================

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  password      String
  firstName     String
  lastName      String
  phone         String?
  address       String?
  role          UserRole  @default(MEMBER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  children           Child[]
  memberships        Membership[]
  membershipRequests MembershipRequest[]
  donations          Donation[]
  eventRegistrations EventRegistration[]
  contactMessages    ContactMessage[]
  serviceRequests    ServiceRequest[]
  enrollments        Enrollment[]
  profile            UserProfile?
  notifications      Notification[]
  payments           Payment[]
  waitingLists       WaitingList[]
  refundRequests     RefundRequest[]
  processedRefunds   RefundRequest[]  @relation("RefundProcessor")

  // Nouvelles relations pour contenu (migration Directus)
  managedEvents      Event[]          @relation("EventManager")
  managedActivities  Activity[]       @relation("ActivityManager")
  articles           Article[]
  teamMember         TeamMember?

  @@map("users")
}

model Child {
  id                String   @id @default(uuid()) @db.Uuid
  firstName         String
  lastName          String
  nickName          String?  // Surnom optionnel
  birthDate         DateTime
  gender            String?  // "MALE", "FEMALE" - nullable pour données existantes
  notes             String?  // Allergies, informations médicales, etc.
  avatarUrl         String?  // Photo de profil optionnelle
  parentId          String   @db.Uuid
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  parent            User               @relation(fields: [parentId], references: [id], onDelete: Cascade)
  enrollments       Enrollment[]
  eventRegistrations EventRegistration[]

  @@map("children")
}

model Membership {
  id                     String           @id @default(uuid()) @db.Uuid
  userId                 String           @db.Uuid
  type                   MembershipType
  status                 MembershipStatus @default(PENDING)
  paymentStatus          PaymentStatus    @default(PENDING)
  amount                 Float
  startDate              DateTime
  endDate                DateTime
  stripeSessionId        String?          @unique
  stripePaymentIntentId  String?          @unique
  receiptSent            Boolean          @default(false)
  receiptSentAt          DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  membershipRequest MembershipRequest?

  @@map("memberships")
}

// Demandes d'adhésion avec workflow d'approbation
model MembershipRequest {
  id                String                   @id @default(uuid()) @db.Uuid

  // Informations du demandeur
  firstName         String
  lastName          String
  email             String
  phone             String
  dateOfBirth       DateTime?

  // Adresse
  address           String
  city              String
  postalCode        String
  country           String                   @default("Suisse")

  // Type et dates
  membershipType    MembershipType           // ACTIF ou PASSIF (ou anciens types)
  desiredStartDate  DateTime

  // Message optionnel
  motivation        String?

  // Statut et workflow
  status            MembershipRequestStatus  @default(PENDING)

  // Validation admin
  reviewedBy        String?                  @db.Uuid
  reviewedAt        DateTime?
  rejectionReason   String?

  // Lien de paiement
  paymentToken      String?                  @unique
  paymentLinkSentAt DateTime?
  paymentExpiresAt  DateTime?

  // Paiement
  stripeSessionId   String?                  @unique
  paidAt            DateTime?
  membershipId      String?                  @unique @db.Uuid
  userId            String?                  @db.Uuid

  // Métadonnées
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  // Relations
  membership        Membership?              @relation(fields: [membershipId], references: [id])
  user              User?                    @relation(fields: [userId], references: [id])

  @@map("membership_requests")
  @@index([email])
  @@index([status])
  @@index([paymentToken])
}

// Inscriptions aux activités
model Enrollment {
  id            String           @id @default(uuid()) @db.Uuid
  userId        String?          @db.Uuid
  childId       String?          @db.Uuid

  // Référence à Activity (nouveau système Prisma)
  activityId    String?          @db.Uuid
  activity      Activity?        @relation(fields: [activityId], references: [id], onDelete: SetNull)

  levelId       String?          // Niveau optionnel
  activityTitle String           // Titre gardé pour compatibilité
  status        EnrollmentStatus @default(PENDING)
  notes         String?          // Notes publiques (du parent)

  // Champs de paiement
  requiresPayment   Boolean      @default(false)
  paymentAmount     Float?       // Montant à payer
  paymentId         String?      @db.Uuid // Lien vers Payment
  paymentToken      String?      @unique  // Token pour lien de paiement
  paymentExpiresAt  DateTime?    // Expiration du lien de paiement

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user          User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  child         Child?           @relation(fields: [childId], references: [id], onDelete: Cascade)
  payment       Payment?         @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@map("enrollments")
  @@index([paymentToken])
  @@index([activityId])
  @@index([createdAt])
}

model Donation {
  id                String       @id @default(uuid()) @db.Uuid
  userId            String?      @db.Uuid
  firstName         String
  lastName          String
  email             String
  phone             String?
  amount            Float
  type              DonationType

  // Référence à Project (nouveau système Prisma)
  projectId         String?      @db.Uuid
  project           Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectName       String?      // Nom gardé pour compatibilité

  message           String?
  anonymous         Boolean      @default(false)
  stripeSessionId   String?      @unique // ID de la session Stripe Checkout
  transactionId     String?      @unique // ID de transaction externe (RaiseNow, Tamaro, etc.)
  receiptSent       Boolean      @default(false) // Reçu envoyé par email
  receiptSentAt     DateTime?    // Date d'envoi du reçu
  createdAt         DateTime     @default(now())

  user              User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("donations")
  @@index([email])
  @@index([createdAt])
  @@index([projectId])
}

model EventRegistration {
  id                String             @id @default(uuid()) @db.Uuid
  userId            String?            @db.Uuid
  childId           String?            @db.Uuid // Pour inscriptions d'enfants

  // Référence à Event (nouveau système Prisma)
  eventId           String?            @db.Uuid
  event             Event?             @relation(fields: [eventId], references: [id], onDelete: SetNull)
  eventTitle        String             // Titre gardé pour compatibilité

  // Type d'inscription
  participationType String             @default("INDIVIDUAL") // INDIVIDUAL, FAMILY, CHILD

  // Contact principal (parent si enfant)
  firstName         String
  lastName          String
  email             String
  phone             String

  // Pour inscriptions FAMILY
  numberOfAdults    Int                @default(1)
  numberOfChildren  Int                @default(0)
  participants      Json?              // { adults: [{firstName, lastName}], children: [{firstName, lastName, age}] }

  // Pour inscriptions INDIVIDUAL ou CHILD
  participantAge    Int?               // Âge du participant (si restriction d'âge)
  participantGender String?            // MALE, FEMALE, CHILD

  // Paiement
  requiresPayment   Boolean            @default(false)
  paymentAmount     Float?
  paymentId         String?            @db.Uuid // Lien vers Payment

  // Anciens champs (compatibilité)
  attendees         Int                @default(1)

  status            RegistrationStatus @default(PENDING)
  notes             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  user              User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  child             Child?             @relation(fields: [childId], references: [id], onDelete: Cascade)
  payment           Payment?           @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  refundRequests    RefundRequest[]

  @@map("event_registrations")
  @@index([eventId])
  @@index([createdAt])
}

model ContactMessage {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  firstName String
  lastName  String
  email     String
  phone     String?
  subject   String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  // Champs pour messages à l'organisateur
  organizerEmail  String?   // Email de l'organisateur destinataire
  itemType        String?   // 'event' ou 'activity'
  itemId          String?   // ID de l'événement/activité dans Directus
  itemTitle       String?   // Titre pour référence

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("contact_messages")
  @@index([organizerEmail])
  @@index([itemType])
}

model ServiceRequest {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String?       @db.Uuid
  serviceType ServiceType
  status      ServiceStatus @default(PENDING)
  firstName   String
  lastName    String
  email       String
  phone       String
  details     String
  requestDate DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("service_requests")
}

// NextAuth tables
model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model MosqueSettings {
  id            String   @id @default(uuid()) @db.Uuid
  key           String   @unique
  value         String?
  description   String?
  updatedAt     DateTime @updatedAt
  updatedBy     String?  // Email de l'admin qui a modifié

  @@map("mosque_settings")
}

// Historique des modifications des paramètres (Directus mosque_settings)
model SettingsHistory {
  id          String   @id @default(uuid()) @db.Uuid
  settingKey  String   // Ex: "bank_iban", "contact_email", "membership_monthly_price"
  oldValue    String?  // Ancienne valeur (null si création)
  newValue    String?  // Nouvelle valeur (null si suppression)
  changedBy   String   // Email de l'admin qui a modifié
  changedAt   DateTime @default(now())

  @@map("settings_history")
  @@index([settingKey])
  @@index([changedAt])
}

// Profil utilisateur étendu pour l'espace membre
model UserProfile {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @db.Uuid
  city              String?
  postalCode        String?
  country           String?  @default("Suisse")
  dateOfBirth       DateTime?
  profilePicture    String?  // URL de l'image
  bio               String?
  preferredLanguage String   @default("fr") // "fr" ou "ar"
  notificationEmail Boolean  @default(true)
  notificationSms   Boolean  @default(false)
  newsletter        Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

// Système de notifications pour l'espace membre
model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType // Type de notification
  title     String
  message   String
  link      String?          // URL relative pour le lien
  read      Boolean          @default(false)
  emailSent Boolean          @default(false) // Email envoyé ou non
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
  @@index([userId, read])
}

// Paiements Stripe
model Payment {
  id                   String        @id @default(uuid()) @db.Uuid
  userId               String?       @db.Uuid

  // Référence à Event (nouveau système Prisma)
  eventId              String?       @db.Uuid
  event                Event?        @relation("EventPayment", fields: [eventId], references: [id], onDelete: SetNull)

  enrollmentId         String?       @db.Uuid
  amount               Float
  currency             String        @default("CHF")
  status               PaymentStatus @default(PENDING)
  stripePaymentId      String?       @unique // payment_intent_id de Stripe
  stripeCheckoutId     String?       // checkout_session_id de Stripe
  stripeSubscriptionId String?       // subscription_id de Stripe (pour abonnements)
  metadata             Json?         // Données additionnelles
  paidAt              DateTime?
  failedAt            DateTime?
  failureReason       String?
  refundedAt          DateTime?
  refundAmount        Float?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  user                User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  eventRegistrations  EventRegistration[]
  enrollments         Enrollment[]
  refundRequests      RefundRequest[]

  @@map("payments")
  @@index([userId])
  @@index([stripePaymentId])
  @@index([eventId])
}

// Liste d'attente pour événements/activités
model WaitingList {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String?  @db.Uuid
  childId         String?  @db.Uuid

  // Référence à Event (nouveau système Prisma)
  eventId         String?  @db.Uuid
  event           Event?   @relation("EventWaitingList", fields: [eventId], references: [id], onDelete: SetNull)
  eventTitle      String?  // Titre gardé pour compatibilité

  // Référence à Activity (nouveau système Prisma)
  activityId      String?  @db.Uuid
  activity        Activity? @relation("ActivityWaitingList", fields: [activityId], references: [id], onDelete: SetNull)
  activityTitle   String?  // Titre gardé pour compatibilité

  contactEmail    String
  contactPhone    String?
  contactName     String
  notified        Boolean  @default(false) // Notifié d'une place disponible
  notifiedAt      DateTime?
  convertedToRegistration Boolean @default(false) // Converti en inscription
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("waiting_lists")
  @@index([eventId, notified])
  @@index([activityId, notified])
  @@index([userId])
}

// Permissions par rôle pour l'administration
model RolePermission {
  id         String          @id @default(uuid()) @db.Uuid
  role       UserRole
  permission AdminPermission
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([role, permission])
  @@map("role_permissions")
  @@index([role])
}

// Statuts pour les demandes de remboursement
enum RefundRequestStatus {
  PENDING   // En attente d'approbation
  APPROVED  // Approuvé - remboursement en cours
  REJECTED  // Rejeté par l'organisateur
  COMPLETED // Remboursement effectué
  CANCELLED // Demande annulée par le participant
}

// Demandes de remboursement
model RefundRequest {
  id                String              @id @default(uuid()) @db.Uuid
  userId            String?             @db.Uuid
  registrationId    String              @db.Uuid
  paymentId         String              @db.Uuid
  eventId           String              // Référence à Directus event
  eventTitle        String
  amount            Float               // Montant à rembourser
  reason            String?             // Raison de la demande
  status            RefundRequestStatus @default(PENDING)

  // Réponse de l'organisateur
  processedBy       String?             @db.Uuid // ID de l'utilisateur qui a traité
  processedAt       DateTime?
  rejectionReason   String?             // Raison du refus

  // Informations Stripe
  stripeRefundId    String?             // ID du remboursement Stripe
  refundedAt        DateTime?

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  user              User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  registration      EventRegistration   @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  payment           Payment             @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  processedByUser   User?               @relation("RefundProcessor", fields: [processedBy], references: [id], onDelete: SetNull)

  @@map("refund_requests")
  @@index([userId])
  @@index([registrationId])
  @@index([status])
}

// Types de logos
enum LogoType {
  PRIMARY       // Logo principal
  HORIZONTAL    // Logo horizontal
  ICON          // Icône seule
  FAVICON       // Favicon
  EMAIL         // Logo pour emails
}

// Variantes de couleur
enum LogoColorVariant {
  COLOR   // Couleur originale
  WHITE   // Blanc (pour fonds sombres)
  DARK    // Sombre (pour fonds clairs)
}

// Emplacements où un logo peut être utilisé
enum LogoLocation {
  HEADER          // Navigation principale
  FOOTER          // Pied de page
  DASHBOARD       // Dashboard admin/membre
  DASHBOARD_MOBILE // Dashboard mobile
  EMAIL_HEADER    // En-tête des emails
  EMAIL_FOOTER    // Pied des emails
  OG_IMAGE        // Image OpenGraph
  FAVICON         // Favicon du navigateur
}

// Fichiers de logos uploadés
model Logo {
  id            String            @id @default(uuid()) @db.Uuid
  name          String            // Nom du logo (ex: "Logo principal couleur")
  type          LogoType          // Type de logo
  colorVariant  LogoColorVariant  // Variante de couleur
  filePath      String            // Chemin du fichier (ex: /logos/uploads/xxx.png)
  fileName      String            // Nom original du fichier
  fileSize      Int               // Taille en bytes
  mimeType      String            // Type MIME (image/png, image/svg+xml, etc.)
  width         Int?              // Largeur en pixels
  height        Int?              // Hauteur en pixels
  isDefault     Boolean           @default(false) // Logo par défaut pour ce type/variante

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  // Relations
  locationConfigs LogoLocationConfig[]

  @@map("logos")
  @@index([type, colorVariant])
}

// Configuration des logos par emplacement
model LogoLocationConfig {
  id            String        @id @default(uuid()) @db.Uuid
  location      LogoLocation  @unique // Un seul logo par emplacement
  logoId        String        @db.Uuid
  className     String?       // Classes CSS optionnelles

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  logo          Logo          @relation(fields: [logoId], references: [id], onDelete: Cascade)

  @@map("logo_location_configs")
}
