// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  IMAM
  TEACHER
  STAFF
  MEMBER
}

enum MembershipType {
  INDIVIDUAL
  FAMILY
  STUDENT
  SENIOR
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  PENDING
}

enum DonationType {
  ZAKAT
  SADAQA
  ZAKAT_AL_FITR
  PROJECT
  MEMBERSHIP
}

enum ServiceType {
  MARRIAGE
  FUNERAL
  SHAHADA
  AQIQA
}

enum ServiceStatus {
  PENDING
  APPROVED
  COMPLETED
  CANCELLED
}

enum EnrollmentStatus {
  PENDING
  APPROVED
  REJECTED
  WAITING_LIST
  INTERVIEW_REQUIRED
  ACTIVE
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

enum NotificationType {
  EVENT_CONFIRMATION
  EVENT_REMINDER
  EVENT_CANCELLED
  EVENT_WAITLIST_SPOT_AVAILABLE
  ENROLLMENT_CONFIRMATION
  ENROLLMENT_APPROVED
  ENROLLMENT_REJECTED
  PAYMENT_PENDING
  PAYMENT_CONFIRMED
  PAYMENT_FAILED
  SYSTEM
  REMINDER
}

enum ActivityStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ActivityCategory {
  QURAN
  ARABIC
  SUNDAY_SCHOOL
  HALAQAT
  WOMEN
  SUPPORT
  OTHER
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  password      String
  firstName     String
  lastName      String
  phone         String?
  address       String?
  role          UserRole  @default(MEMBER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  children           Child[]
  memberships        Membership[]
  donations          Donation[]
  eventRegistrations EventRegistration[]
  contactMessages    ContactMessage[]
  serviceRequests    ServiceRequest[]
  enrollments        Enrollment[]
  profile            UserProfile?
  notifications      Notification[]
  payments           Payment[]
  waitingLists       WaitingList[]

  @@map("users")
}

model Child {
  id                String   @id @default(uuid()) @db.Uuid
  firstName         String
  lastName          String
  nickName          String?  // Surnom optionnel
  birthDate         DateTime
  gender            String?  // "MALE", "FEMALE" - nullable pour données existantes
  notes             String?  // Allergies, informations médicales, etc.
  avatarUrl         String?  // Photo de profil optionnelle
  parentId          String   @db.Uuid
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  parent            User               @relation(fields: [parentId], references: [id], onDelete: Cascade)
  enrollments       Enrollment[]
  eventRegistrations EventRegistration[]

  @@map("children")
}

model Membership {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @db.Uuid
  type        MembershipType
  status      MembershipStatus @default(PENDING)
  amount      Float
  startDate   DateTime
  endDate     DateTime
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("memberships")
}

// NOTE: Activity and ActivityLevel are managed by Directus, not Prisma
// Enrollments reference Directus activities via activityIdOld string field

model Enrollment {
  id            String           @id @default(uuid()) @db.Uuid
  userId        String?          @db.Uuid
  childId       String?          @db.Uuid
  activityId    String?          // Directus activity reference (String ID)
  activityIdOld String?          // Legacy Directus/Sanity reference
  levelId       String?          // Directus level reference (String ID)
  activityTitle String
  status        EnrollmentStatus @default(PENDING)
  notes         String?          // Notes publiques (du parent)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user          User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  child         Child?           @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@map("enrollments")
}

model Donation {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String?      @db.Uuid
  firstName   String
  lastName    String
  email       String
  phone       String?
  amount      Float
  type        DonationType
  projectId   String?      // Référence à Sanity si PROJECT
  projectName String?
  message     String?
  anonymous   Boolean      @default(false)
  createdAt   DateTime     @default(now())

  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("donations")
}

model EventRegistration {
  id                String             @id @default(uuid()) @db.Uuid
  userId            String?            @db.Uuid
  childId           String?            @db.Uuid // Pour inscriptions d'enfants
  eventId           String             // Référence à Directus
  eventTitle        String

  // Type d'inscription
  participationType String             @default("INDIVIDUAL") // INDIVIDUAL, FAMILY, CHILD

  // Contact principal (parent si enfant)
  firstName         String
  lastName          String
  email             String
  phone             String

  // Pour inscriptions FAMILY
  numberOfAdults    Int                @default(1)
  numberOfChildren  Int                @default(0)
  participants      Json?              // { adults: [{firstName, lastName}], children: [{firstName, lastName, age}] }

  // Pour inscriptions INDIVIDUAL ou CHILD
  participantAge    Int?               // Âge du participant (si restriction d'âge)
  participantGender String?            // MALE, FEMALE, CHILD

  // Paiement
  requiresPayment   Boolean            @default(false)
  paymentAmount     Float?
  paymentId         String?            @db.Uuid // Lien vers Payment

  // Anciens champs (compatibilité)
  attendees         Int                @default(1)

  status            RegistrationStatus @default(PENDING)
  notes             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  user              User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  child             Child?             @relation(fields: [childId], references: [id], onDelete: Cascade)
  payment           Payment?           @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@map("event_registrations")
}

model ContactMessage {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  firstName String
  lastName  String
  email     String
  phone     String?
  subject   String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("contact_messages")
}

model ServiceRequest {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String?       @db.Uuid
  serviceType ServiceType
  status      ServiceStatus @default(PENDING)
  firstName   String
  lastName    String
  email       String
  phone       String
  details     String
  requestDate DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("service_requests")
}

// NextAuth tables
model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model MosqueSettings {
  id            String   @id @default(uuid()) @db.Uuid
  key           String   @unique
  value         String?
  description   String?
  updatedAt     DateTime @updatedAt
  updatedBy     String?  // Email de l'admin qui a modifié

  @@map("mosque_settings")
}

// Profil utilisateur étendu pour l'espace membre
model UserProfile {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @db.Uuid
  city              String?
  postalCode        String?
  country           String?  @default("France")
  dateOfBirth       DateTime?
  profilePicture    String?  // URL de l'image
  bio               String?
  preferredLanguage String   @default("fr") // "fr" ou "ar"
  notificationEmail Boolean  @default(true)
  notificationSms   Boolean  @default(false)
  newsletter        Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

// Système de notifications pour l'espace membre
model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType // Type de notification
  title     String
  message   String
  link      String?          // URL relative pour le lien
  read      Boolean          @default(false)
  emailSent Boolean          @default(false) // Email envoyé ou non
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
  @@index([userId, read])
}

// Paiements Stripe
model Payment {
  id                  String        @id @default(uuid()) @db.Uuid
  userId              String?       @db.Uuid
  eventId             String?       // Référence à Directus event
  enrollmentId        String?       @db.Uuid
  amount              Float
  currency            String        @default("CHF")
  status              PaymentStatus @default(PENDING)
  stripePaymentId     String?       @unique // payment_intent_id de Stripe
  stripeCheckoutId    String?       // checkout_session_id de Stripe
  metadata            Json?         // Données additionnelles
  paidAt              DateTime?
  failedAt            DateTime?
  failureReason       String?
  refundedAt          DateTime?
  refundAmount        Float?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  user                User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  eventRegistrations  EventRegistration[]

  @@map("payments")
  @@index([userId])
  @@index([stripePaymentId])
}

// Liste d'attente pour événements/activités
model WaitingList {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String?  @db.Uuid
  childId         String?  @db.Uuid
  eventId         String?  // Référence à Directus event
  activityId      String?  // Référence à Directus activity
  eventTitle      String?
  activityTitle   String?
  contactEmail    String
  contactPhone    String?
  contactName     String
  notified        Boolean  @default(false) // Notifié d'une place disponible
  notifiedAt      DateTime?
  convertedToRegistration Boolean @default(false) // Converti en inscription
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("waiting_lists")
  @@index([eventId, notified])
  @@index([activityId, notified])
  @@index([userId])
}
